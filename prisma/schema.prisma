generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Assessment {
  id                   String                 @id @default(cuid())
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  userId               String?
  objective            String?
  propertyType         String?
  orientation          String?
  roofType             String?
  year                 Int
  area                 Float
  zipcode              String
  heating              String?
  cooling              String?
  waterHeating         String?
  ventilation          String?
  windows              String?
  renewables           String?
  facadeInsulation     String?
  roofInsulation       String?
  budgetRange          String?
  timelineHorizon      String?
  targetLetter         String?
  isDemo               Boolean                @default(false)
  score                Float?
  estimatedLetter      String
  confidence           String
  climateZone          String?
  penalties            String?
  strengths            String?
  missingData          String?
  explanation          String?
  isPremium            Boolean                @default(false)
  latitude             Float?
  locationSource       String?
  longitude            Float?
  paidAt               DateTime?
  stripeSessionId      String?                @unique
  stripePaymentIntent  String?
  stripeCustomerId     String?
  paidAmountCents      Int?
  paidCurrency         String?
  paymentStatus        String                 @default("unpaid")
  source               String?
  partnerSlug          String?
  providerId           String?
  attributionOwner     String?
  attributionExpiresAt DateTime?
  analyticsEvents      AnalyticsEventLog[]
  user                 User?                  @relation(fields: [userId], references: [id])
  attachments          AssessmentAttachment[]
  cadastralRecord      CadastralRecord?
  checkoutRecovery     CheckoutRecovery?
  dataFieldSources     DataFieldSource[]
  energyCertificates   EnergyCertificate[]
  costEstimateRuns     EstimateRun[]
  leads                Lead[]
  rehabBudgets         RehabBudget[]
}

model CadastralRecord {
  id                 String     @id @default(cuid())
  assessmentId       String     @unique
  cadastralReference String?
  province           String?
  municipality       String?
  address            String?
  postalCode         String?
  lat                Float?
  lng                Float?
  surfaceBuiltM2     Float?
  surfacePlotM2      Float?
  yearBuilt          Int?
  sourceSystem       String     @default("catastro")
  sourceMode         String?
  confidence         Float?     @default(1)
  retrievedAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  internalBlock      String?
  internalDoor       String?
  internalFloor      String?
  internalStaircase  String?
  parcelReference    String?
  participationPct   Float?
  propertyUse        String?
  surfaceCommonM2    Float?
  surfaceDwellingM2  Float?
  assessment         Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}

model AssessmentAttachment {
  id                 String              @id @default(cuid())
  assessmentId       String
  name               String
  type               String
  size               Int
  path               String
  createdAt          DateTime            @default(now())
  category           String?
  ocrStatus          String              @default("pending")
  ocrData            Json?
  ocrProcessedAt     DateTime?
  ocrError           String?
  assessment         Assessment          @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  analysis           AttachmentAnalysis?
  energyCertificates EnergyCertificate[]
  rehabBudgets       RehabBudget[]
}

model AttachmentAnalysis {
  id            String               @id @default(cuid())
  attachmentId  String               @unique
  model         String
  status        String               @default("PENDING")
  imageType     String?
  detectedJson  Json?
  confidence    String?
  reportSummary String?
  warnings      Json?
  errorMessage  String?
  analyzedAt    DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  attachment    AssessmentAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
}

model EnergyCertificate {
  id                      String                @id @default(cuid())
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  assessmentId            String
  attachmentId            String?
  sourceProgram           String?
  sourceFormat            String
  extractionStatus        String
  extractionConfidence    Float?
  issueDate               DateTime?
  validUntil              DateTime?
  addressLine             String?
  cadastralReference      String?
  postalCode              String?
  municipality            String?
  province                String?
  useType                 String?
  climateZone             String?
  yearBuilt               Int?
  usefulAreaM2            Float?
  builtAreaM2             Float?
  globalLetter            String?
  nonRenewableEPKwhM2Year Float?
  emissionsKgCO2M2Year    Float?
  heatingDemandKwhM2Year  Float?
  coolingDemandKwhM2Year  Float?
  acsDemandKwhM2Year      Float?
  recommendationsJson     Json?
  extractedFieldsJson     Json?
  rawTextHash             String?
  rawXmlStored            Boolean               @default(false)
  reviewNotes             String?
  assessment              Assessment            @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  attachment              AssessmentAttachment? @relation(fields: [attachmentId], references: [id])
}

model RehabBudget {
  id                        String                @id @default(cuid())
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  assessmentId              String
  attachmentId              String?
  sourceFormat              String
  extractionStatus          String
  extractionConfidence      Float?
  providerName              String?
  budgetDate                DateTime?
  totalAmount               Float?
  currency                  String                @default("EUR")
  vatIncluded               Boolean?
  detectedCategoriesJson    Json?
  detectedMeasuresJson      Json?
  lineItemsJson             Json?
  estimatedCurrentLetter    String?
  estimatedPostBudgetLetter String?
  targetLetter              String?
  targetReached             Boolean?
  impactConfidence          String?
  missingMeasuresJson       Json?
  analysisSummary           String?
  assessment                Assessment            @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  attachment                AssessmentAttachment? @relation(fields: [attachmentId], references: [id])
}

model DataFieldSource {
  id              String     @id @default(cuid())
  createdAt       DateTime   @default(now())
  assessmentId    String
  fieldName       String
  valueJson       Json
  sourceType      String
  sourceId        String?
  confidence      Float?
  requiresReview  Boolean    @default(false)
  appliedToWizard Boolean    @default(false)
  assessment      Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}

model Provider {
  id                 String                     @id @default(cuid())
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  name               String
  legalName          String?
  taxId              String?
  contactName        String?
  email              String?
  phone              String?
  website            String?
  categories         String
  zones              String
  certifications     String?
  status             String                     @default("PENDING")
  verified           Boolean                    @default(false)
  rating             Float                      @default(4.5)
  slaHours           Int?
  commissionType     String?
  commissionRate     Float?
  leadFeeCents       Int?
  monthlyFeeCents    Int?
  attributionMonths  Int                        @default(12)
  notes              String?
  source             String?
  partnerId          String?
  leadCreditsBalance Int                        @default(0)
  leads              Lead[]
  partner            Partner?                   @relation(fields: [partnerId], references: [id])
  accounts           ProviderAccount?
  creditLedger       ProviderLeadCreditLedger[]
  subscriptions      ProviderSubscription[]
}

model Partner {
  id                    String     @id @default(cuid())
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  name                  String
  type                  String     @default("REAL_ESTATE")
  company               String?
  email                 String?
  phone                 String?
  website               String?
  status                String     @default("ACTIVE")
  attributionMonths     Int        @default(12)
  defaultCommissionRate Float?
  notes                 String?
  leads                 Lead[]
  providers             Provider[]
}

model Lead {
  id                   String      @id @default(cuid())
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  userId               String?
  assessmentId         String?
  providerId           String?
  partnerId            String?
  userName             String?
  userEmail            String?
  userPhone            String?
  requestedService     String?
  estimatedBudget      String?
  urgency              String?
  zone                 String?
  source               String?
  attributionOwner     String?
  attributionExpiresAt DateTime?
  status               String      @default("PENDING")
  commissionStatus     String      @default("NOT_APPLICABLE")
  expectedValueCents   Int?
  closedValueCents     Int?
  commissionCents      Int?
  consentAccepted      Boolean     @default(false)
  notes                String?
  contactUnlockedAt    DateTime?
  consentObtainedBy    String?
  consentMethod        String?
  consentObtainedAt    DateTime?
  consentText          String?
  consentWithdrawToken String?     @unique
  clientEmail          String?
  clientName           String?
  clientPhone          String?
  assessment           Assessment? @relation(fields: [assessmentId], references: [id])
  partner              Partner?    @relation(fields: [partnerId], references: [id])
  provider             Provider?   @relation(fields: [providerId], references: [id])
  user                 User?       @relation(fields: [userId], references: [id])
}

model EmailLog {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  type         String
  toEmailHash  String?
  userId       String?
  assessmentId String?
  provider     String?
  status       String   @default("PENDING")
  externalId   String?
  error        String?
  metadataJson Json?
}

model CheckoutRecovery {
  id              String     @id @default(cuid())
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  assessmentId    String     @unique
  stripeSessionId String?
  userEmailHash   String?
  recoverySentAt  DateTime?
  status          String     @default("PENDING")
  assessment      Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}

model AnalyticsEventLog {
  id           String      @id @default(cuid())
  createdAt    DateTime    @default(now())
  event        String
  userId       String?
  assessmentId String?
  productType  String?
  source       String?
  metadataJson Json?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id])
}

model BudgetReview {
  id                   String    @id @default(cuid())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  userId               String?
  source               String?
  fileName             String?
  filePath             String?
  rawTextHash          String?
  status               String    @default("DRAFT")
  extractionConfidence Float?
  totalAmountCents     Int?
  currency             String    @default("EUR")
  summaryJson          Json?
  lineItemsJson        Json?
  findingsJson         Json?
  paidAt               DateTime?
  stripeSessionId      String?   @unique
  stripePaymentIntent  String?
  paidAmountCents      Int?
  paidCurrency         String?
}

model ProviderAccount {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  userId     String   @unique
  providerId String   @unique
  role       String   @default("OWNER")
  status     String   @default("ACTIVE")
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model ProviderLeadCreditLedger {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  providerId      String
  type            String
  credits         Int
  leadId          String?
  stripeSessionId String?  @unique
  notes           String?
  provider        Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model ProviderSubscription {
  id                   String    @id @default(cuid())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  providerId           String
  status               String    @default("INACTIVE")
  plan                 String?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  provider             Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model ProfessionalAccessRequest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String?
  email     String
  phone     String?
  company   String?
  role      String?
  message   String?
  status    String   @default("PENDING")
}

model KnowledgeEntry {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  category    String
  region      String?
  title       String
  content     String
  tags        String?
  validFrom   DateTime?
  validUntil  DateTime?
  sourceUrl   String?
  sourceLabel String?
  active      Boolean   @default(true)
  createdBy   String?
}

model ProfessionalBranding {
  id                String    @id @default(cuid())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  userId            String    @unique
  brandName         String?
  brandLogoUrl      String?
  brandContactEmail String?
  addonActive       Boolean   @default(false)
  interestedAt      DateTime?
  activatedAt       DateTime?
}

model EnergyBillDataPoint {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  supplyType       String
  amountEur        Float
  consumptionKwh   Float?
  consumptionM3    Float?
  billingDays      Int?
  monthlyAmountEur Float?
  zipCode          String?
  distributorName  String?
  billingYear      Int?
  billingMonth     Int?
  source           String   @default("calculator_import")
}

model User {
  id                  String               @id @default(cuid())
  name                String?
  email               String?              @unique
  emailVerified       DateTime?
  image               String?
  passwordHash        String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  accounts            Account[]
  assessments         Assessment[]
  leads               Lead[]
  passwordResetTokens PasswordResetToken[]
  sessions            Session[]
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PriceSource {
  id           String      @id @default(cuid())
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  name         String
  providerType String
  sourceKind   String
  versionLabel String?
  region       String?
  url          String?
  licenseNote  String?
  reliability  String
  capturedAt   DateTime?
  validFrom    DateTime?
  validTo      DateTime?
  notes        String?
  items        PriceItem[]
}

model PriceItem {
  id           String            @id @default(cuid())
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  guid         String            @unique
  sourceId     String
  code         String
  externalCode String?
  title        String
  description  String?
  unit         String
  minUnitPrice Float
  midUnitPrice Float?
  maxUnitPrice Float
  currency     String            @default("EUR")
  region       String?
  category     String
  applicableTo String
  tags         String
  confidence   String
  isActive     Boolean           @default(true)
  mappings     MeasurePriceMap[]
  source       PriceSource       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
}

model EnergyMeasure {
  id                   String            @id @default(cuid())
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  guid                 String            @unique
  code                 String            @unique
  title                String
  description          String?
  category             String
  impactArea           String
  defaultPriority      String
  complexity           String
  typicalLetterGainMin Int?
  typicalLetterGainMax Int?
  isActive             Boolean           @default(true)
  priceMappings        MeasurePriceMap[]
}

model MeasurePriceMap {
  id              String        @id @default(cuid())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  measureId       String
  priceItemId     String
  quantityFormula String
  defaultFactor   Float         @default(1.0)
  minFactor       Float?
  maxFactor       Float?
  notes           String?
  measure         EnergyMeasure @relation(fields: [measureId], references: [id], onDelete: Cascade)
  priceItem       PriceItem     @relation(fields: [priceItemId], references: [id], onDelete: Cascade)
}

model EstimateRun {
  id               String         @id @default(cuid())
  createdAt        DateTime       @default(now())
  assessmentId     String?
  scenarioId       String?
  scenarioTitle    String?
  propertyType     String?
  profile          String?
  letterGainTarget Int?
  currency         String         @default("EUR")
  minTotal         Float
  midTotal         Float?
  maxTotal         Float
  confidence       String
  sourceSummary    String?
  assumptions      String
  disclaimer       String
  lines            EstimateLine[]
  assessment       Assessment?    @relation(fields: [assessmentId], references: [id])
}

model EstimateLine {
  id            String      @id @default(cuid())
  estimateRunId String
  measureCode   String
  priceItemCode String
  title         String
  unit          String
  quantity      Float
  minUnitPrice  Float
  midUnitPrice  Float?
  maxUnitPrice  Float
  minSubtotal   Float
  midSubtotal   Float?
  maxSubtotal   Float
  sourceLabel   String?
  confidence    String
  assumptions   String?
  estimateRun   EstimateRun @relation(fields: [estimateRunId], references: [id], onDelete: Cascade)
}
