NEXT_PUBLIC_RESIDENTIAL_BUNDLE_PRICE_EUR="29.90"

# Providers
STRIPE_PRICE_PROVIDER_LEAD_PACK=""
NEXT_PUBLIC_PROVIDER_LEAD_PACK_PRICE_EUR="300"
PROVIDER_LEAD_PACK_CREDITS="10"

# Admin
ADMIN_EMAILS=""

# Vision AI (Anthropic) — wizard real-time photo analysis
ANTHROPIC_API_KEY=

# Vision AI (OpenRouter) — premium PDF attachment analysis
# Primary model: google/gemini-2.5-flash-lite | Fallback: qwen/qwen2.5-vl-72b-instruct
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_VISION_FALLBACK_MODEL=qwen/qwen2.5-vl-72b-instruct

# Vision analysis activation policy (all defaults are conservative — off for free users)
ENABLE_VISION_ANALYSIS=true
ENABLE_FREE_VISION_ANALYSIS=false
VISION_ANALYSIS_INCLUDED_IN_PREMIUM=true
VISION_MAX_IMAGES_PREMIUM=3
VISION_MAX_IMAGES_PRO=8

# Hermes Vision Curator agent (deterministic, no LLM by default)
ENABLE_HERMES_VISION_CURATOR=true
ENABLE_HERMES_VISION_LLM_CURATION=false
HERMES_VISION_MAX_FINDINGS=8
