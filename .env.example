# Budget review
STRIPE_PRICE_BUDGET_REVIEW=""
NEXT_PUBLIC_BUDGET_REVIEW_PRICE_EUR="14.90"
NEXT_PUBLIC_BUDGET_REVIEW_STANDARD_PRICE_EUR="19.90"

